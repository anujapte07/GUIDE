#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x563e25a79130 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x563e25a792c0 .scope module, "tb_binary_to_bcd_converter" "tb_binary_to_bcd_converter" 3 3;
 .timescale -9 -12;
v0x563e25a8f3f0_0 .net "bcd_output", 7 0, v0x563e25a3f690_0;  1 drivers
v0x563e25a8f4b0_0 .var "binary_input", 4 0;
v0x563e25a8f580_0 .var "expected_bcd", 7 0;
v0x563e25a8f650_0 .var/i "i", 31 0;
v0x563e25a8f730_0 .var "test_binary", 4 0;
v0x563e25a8f860_0 .var "vcd_clk", 0 0;
S_0x563e25a3f490 .scope module, "uut" "binary_to_bcd_converter" 3 8, 4 1 0, S_0x563e25a792c0;
 .timescale 0 0;
    .port_info 0 /INPUT 5 "binary_input";
    .port_info 1 /OUTPUT 8 "bcd_output";
v0x563e25a3f690_0 .var "bcd_output", 7 0;
v0x563e25a8f2b0_0 .net "binary_input", 4 0, v0x563e25a8f4b0_0;  1 drivers
E_0x563e25a3ff80 .event anyedge, v0x563e25a8f2b0_0;
    .scope S_0x563e25a3f490;
T_0 ;
    %wait E_0x563e25a3ff80;
    %load/vec4 v0x563e25a8f2b0_0;
    %pad/u 32;
    %pushi/vec4 10, 0, 32;
    %div;
    %pad/u 4;
    %ix/load 4, 4, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x563e25a3f690_0, 4, 4;
    %load/vec4 v0x563e25a8f2b0_0;
    %pad/u 32;
    %pushi/vec4 10, 0, 32;
    %mod;
    %pad/u 4;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x563e25a3f690_0, 4, 4;
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x563e25a792c0;
T_1 ;
    %vpi_call/w 3 18 "$display", "Testing Binary-to-BCD Converter..." {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x563e25a8f650_0, 0, 32;
T_1.0 ;
    %load/vec4 v0x563e25a8f650_0;
    %cmpi/s 32, 0, 32;
    %jmp/0xz T_1.1, 5;
    %load/vec4 v0x563e25a8f650_0;
    %pad/s 5;
    %store/vec4 v0x563e25a8f730_0, 0, 5;
    %load/vec4 v0x563e25a8f730_0;
    %store/vec4 v0x563e25a8f4b0_0, 0, 5;
    %load/vec4 v0x563e25a8f730_0;
    %pad/u 32;
    %pushi/vec4 10, 0, 32;
    %mod;
    %pad/u 4;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x563e25a8f580_0, 4, 4;
    %load/vec4 v0x563e25a8f730_0;
    %pad/u 32;
    %pushi/vec4 10, 0, 32;
    %div;
    %pad/u 4;
    %ix/load 4, 4, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x563e25a8f580_0, 4, 4;
    %delay 10000, 0;
    %load/vec4 v0x563e25a8f3f0_0;
    %load/vec4 v0x563e25a8f580_0;
    %cmp/ne;
    %jmp/0xz  T_1.2, 6;
    %vpi_call/w 3 31 "$display", "Error: Test case %0d failed. Expected BCD: 8'b%0b, Got: 8'b%0b", v0x563e25a8f730_0, v0x563e25a8f580_0, v0x563e25a8f3f0_0 {0 0 0};
    %vpi_call/w 3 33 "$finish" {0 0 0};
T_1.2 ;
    ; show_stmt_assign_vector: Get l-value for compressed += operand
    %load/vec4 v0x563e25a8f650_0;
    %pushi/vec4 1, 0, 32;
    %add;
    %store/vec4 v0x563e25a8f650_0, 0, 32;
    %jmp T_1.0;
T_1.1 ;
    %vpi_call/w 3 37 "$display", "All test cases passed!" {0 0 0};
    %vpi_call/w 3 38 "$finish" {0 0 0};
    %end;
    .thread T_1;
    .scope S_0x563e25a792c0;
T_2 ;
    %vpi_call/w 3 43 "$dumpfile", "my_design.vcd" {0 0 0};
    %vpi_call/w 3 44 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x563e25a792c0 {0 0 0};
    %end;
    .thread T_2;
    .scope S_0x563e25a792c0;
T_3 ;
    %delay 5000, 0;
    %load/vec4 v0x563e25a8f860_0;
    %inv;
    %store/vec4 v0x563e25a8f860_0, 0, 1;
    %jmp T_3;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "/home/claude/HW_AutoChip/examples/binary_to_bcd/binary_to_bcd_tb.v";
    "/home/claude/HW_AutoChip/examples/binary_to_bcd/iter0_response0.sv";
